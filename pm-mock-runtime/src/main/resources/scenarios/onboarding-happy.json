{
  "format_version": 1,
  "name": "onboarding-happy",
  "description": "Full happy path machine onboarding flow",
  "start": "onboard.mode",
  "pairing_code": "MOCKMOCK",
  "routes": {
    "GET /api/v1/status": {
      "representation": {
        "status": "onboarding",
        "onboarded": false
      }
    }
  },
  "states": {
    "onboard.mode": {
      "representation": {
        "scope": "workspace",
        "state": "onboard.mode",
        "summary": "Choose onboarding mode"
      },
      "links": {
        "begin": {
          "next": "language.choose",
          "href": "/api/v1/operator/onboard/begin"
        }
      }
    },
    "language.choose": {
      "representation": {
        "scope": "workspace",
        "state": "language.choose",
        "summary": "Choose languages"
      },
      "links": {
        "choose_language": {
          "next": "harness.choose",
          "href": "/api/v1/operator/onboard/language"
        }
      }
    },
    "harness.choose": {
      "representation": {
        "scope": "workspace",
        "state": "harness.choose",
        "summary": "Choose harnesses to enrol"
      },
      "links": {
        "check_harnesses": {
          "next": "harness.probe",
          "href": "/api/v1/operator/onboard/harness/check"
        }
      }
    },
    "harness.probe": {
      "representation": {
        "scope": "workspace",
        "state": "harness.probe",
        "summary": "Checking harnesses"
      },
      "events": [
        {
          "after_ms": 100,
          "event": "check",
          "data": {
            "harness": "Claude Code",
            "status": "pass"
          }
        }
      ],
      "auto": {
        "after_ms": 250,
        "next": "harness.confirm"
      }
    },
    "harness.confirm": {
      "representation": {
        "scope": "workspace",
        "state": "harness.confirm",
        "summary": "Confirm harness enrolment"
      },
      "links": {
        "enrol": {
          "next": "onboard.completed",
          "href": "/api/v1/operator/onboard/harness/enrol"
        }
      }
    },
    "onboard.completed": {
      "representation": {
        "scope": "workspace",
        "state": "onboard.completed",
        "summary": "Machine setup is complete"
      },
      "links": {}
    }
  }
}
