{
  "format_version": 1,
  "name": "entry-ssh-session",
  "description": "The entry in an SSH session: the ways in stay at hand and a code is issued whatever browser of the machine is paired (UC-ENT-1, entry.show -> entry.wait)",
  "start": "entry.ssh",
  "pairing_code": "KXQB-MRTN",
  "routes": {
    "GET /api/v1/status": {
      "representation": {
        "status": "ready",
        "version": "0.9.0",
        "machine": "mock-machine",
        "onboarded": true,
        "onboard": {
          "state": "onboard.completed",
          "step": 7,
          "steps": 7,
          "completed": true
        },
        "web": {
          "enabled": true,
          "lan": false,
          "port": 7420,
          "lan_port": 7421,
          "open": true
        },
        "paired_devices_count": 0
      }
    },
    "GET /api/v1/web/devices": {
      "representation": {
        "devices": []
      }
    }
  },
  "states": {
    "entry.ssh": {
      "representation": {
        "scope": "machine",
        "state": "entry.ssh",
        "summary": "SSH session: no browser opened here",
        "ways_in": [
          {
            "kind": "forward",
            "command": "ssh -L 7420:127.0.0.1:7420 operator@mock-machine"
          },
          {
            "kind": "url",
            "href": "http://127.0.0.1:7420/pair#code=KXQB-MRTN"
          }
        ]
      },
      "links": {
        "pair": {
          "next": "entry.ssh",
          "href": "/api/v1/web/pairings"
        },
        "qr": {
          "next": "entry.ssh",
          "href": "/api/v1/web/pairings"
        }
      }
    }
  }
}
