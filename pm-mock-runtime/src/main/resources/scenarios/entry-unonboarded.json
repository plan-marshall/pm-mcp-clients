{
  "format_version": 1,
  "name": "entry-unonboarded",
  "description": "The entry on a machine that has not been onboarded: the onboarding has not started, no browser is paired, and the network listener is closed (UC-ENT-1, entry.check-onboarded -> entry.where-to-onboard)",
  "start": "entry.where-to-onboard",
  "pairing_code": "KXQB-MRTN",
  "routes": {
    "GET /api/v1/status": {
      "representation": {
        "status": "ready",
        "version": "0.9.0",
        "machine": "mock-machine",
        "onboarded": false,
        "onboard": {
          "state": "onboard.none",
          "step": 0,
          "steps": 7,
          "completed": false
        },
        "web": {
          "enabled": true,
          "lan": false,
          "port": 7420,
          "lan_port": 7421,
          "open": true
        },
        "paired_devices_count": 0
      }
    },
    "GET /api/v1/web/devices": {
      "representation": {
        "devices": []
      }
    }
  },
  "states": {
    "entry.where-to-onboard": {
      "representation": {
        "scope": "machine",
        "state": "entry.where-to-onboard",
        "summary": "Set up this machine for plan-marshall"
      },
      "links": {}
    }
  }
}
