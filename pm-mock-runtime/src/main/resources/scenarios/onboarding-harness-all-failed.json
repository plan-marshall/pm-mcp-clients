{
  "format_version": 1,
  "name": "onboarding-harness-all-failed",
  "description": "Every chosen harness fails its check: the step comes to the same place as none found, each chosen harness with its failed check and its fix.",
  "start": "harness.choose",
  "pairing_code": "MOCKMOCK",
  "routes": {
    "GET /api/v1/status": {
      "representation": {
        "status": "onboarding",
        "onboarded": false
      }
    }
  },
  "states": {
    "harness.choose": {
      "representation": {
        "scope": "machine",
        "state": "harness.choose",
        "summary": "Choose the harnesses to enrol",
        "harnesses": [
          {
            "harness_id": "claude",
            "name": "Claude Code",
            "path": "~/.local/bin/claude",
            "version": "2.4.1",
            "found": true,
            "supported": true,
            "worker_eligible": true,
            "token_usage": "complete",
            "default": true
          },
          {
            "harness_id": "opencode",
            "name": "OpenCode",
            "path": "/opt/homebrew/bin/opencode",
            "version": "0.9.2",
            "found": true,
            "supported": false,
            "worker_eligible": true,
            "token_usage": "partial",
            "missing_figures": ["reasoning"]
          }
        ]
      },
      "links": {
        "check": {
          "next": "harness.probe",
          "href": "/api/v1/onboarding/harness/probe"
        }
      }
    },
    "harness.probe": {
      "representation": {
        "scope": "machine",
        "state": "harness.probe",
        "summary": "Checking 2 harnesses",
        "checks": [
          {
            "harness": "claude",
            "name": "Claude Code",
            "result": "fail",
            "cause": "not logged in",
            "fix": "claude login"
          },
          {
            "harness": "opencode",
            "name": "OpenCode",
            "result": "fail",
            "cause": "version 0.9.2 is not supported (1.5 - 1.x)",
            "fix": "install a version in 1.5 - 1.x, then check again"
          }
        ]
      },
      "links": {
        "continue": {
          "next": "harness.none",
          "href": "/api/v1/onboarding/harness/probe/continue"
        }
      }
    },
    "harness.none": {
      "representation": {
        "scope": "machine",
        "state": "harness.none",
        "summary": "No harness can be used"
      },
      "links": {
        "recheck": {
          "next": "harness.probe",
          "href": "/api/v1/onboarding/harness/recheck"
        },
        "add": {
          "next": "harness.add",
          "href": "/api/v1/onboarding/harness/add"
        },
        "later": {
          "next": "harness.none",
          "href": "/api/v1/onboarding/harness/none/later"
        }
      }
    },
    "harness.add": {
      "representation": {
        "scope": "machine",
        "state": "harness.add",
        "summary": "Add a harness",
        "client_id": "aider"
      },
      "links": {
        "back": {
          "next": "harness.none",
          "href": "/api/v1/onboarding/harness/add/back"
        },
        "submit": {
          "next": "harness.none",
          "href": "/api/v1/onboarding/harness/add/submit"
        }
      }
    }
  }
}
