{
  "format_version": 1,
  "name": "onboarding-refusals",
  "description": "Each consent of the guided run answered no: a required consent stays and nothing was done, while an optional one goes on without it.",
  "start": "harness.consent",
  "pairing_code": "MOCKMOCK",
  "routes": {
    "GET /api/v1/status": {
      "representation": {
        "status": "onboarding",
        "onboarded": false
      }
    }
  },
  "states": {
    "harness.consent": {
      "representation": {
        "scope": "machine",
        "state": "harness.consent",
        "kind": "scan_harnesses",
        "summary": "Look for harnesses on this machine?"
      },
      "links": {
        "no": { "next": "harness.consent", "href": "/api/v1/onboarding/harness/decline" },
        "yes": { "next": "harness.choose", "href": "/api/v1/onboarding/harness/scan" }
      }
    },
    "harness.choose": {
      "representation": {
        "scope": "machine",
        "state": "harness.choose",
        "summary": "Choose the harnesses to enrol"
      },
      "links": {
        "choose": { "next": "catalogue.consent", "href": "/api/v1/onboarding/harness/choose" }
      }
    },
    "catalogue.consent": {
      "representation": {
        "scope": "machine",
        "state": "catalogue.consent",
        "kind": "probe_harness_models",
        "summary": "Ask the harnesses for their models, and a model for advice?"
      },
      "links": {
        "no": { "next": "catalogue.consent", "href": "/api/v1/onboarding/catalogue/decline" },
        "no_advice": { "next": "catalogue.select", "href": "/api/v1/onboarding/catalogue/no-advice" },
        "yes": { "next": "catalogue.select", "href": "/api/v1/onboarding/catalogue/advice" }
      }
    },
    "catalogue.select": {
      "representation": {
        "scope": "machine",
        "state": "catalogue.select",
        "summary": "Choose the models plans may use"
      },
      "links": {
        "set": { "next": "store.consent", "href": "/api/v1/onboarding/catalogue/record" }
      }
    },
    "store.consent": {
      "representation": {
        "scope": "machine",
        "state": "store.consent",
        "kind": "check_credential_store",
        "summary": "Check the macOS Keychain with a test entry?"
      },
      "links": {
        "no": { "next": "store.consent", "href": "/api/v1/onboarding/store/consent-decline" },
        "yes": { "next": "store.check", "href": "/api/v1/onboarding/store/consent" }
      }
    },
    "store.check": {
      "representation": {
        "scope": "machine",
        "state": "store.check",
        "summary": "Tokens are kept in the macOS Keychain"
      },
      "links": {
        "continue": { "next": "providers.consent", "href": "/api/v1/onboarding/store/record" }
      }
    },
    "providers.consent": {
      "representation": {
        "scope": "machine",
        "state": "providers.consent",
        "kind": "scan_providers",
        "summary": "Look for CLI tools and stored tokens?"
      },
      "links": {
        "no": { "next": "providers.consent", "href": "/api/v1/onboarding/providers/decline" },
        "yes": { "next": "providers.select", "href": "/api/v1/onboarding/providers/scan" }
      }
    },
    "providers.select": {
      "representation": {
        "scope": "machine",
        "state": "providers.select",
        "summary": "Choose what this machine works with"
      },
      "links": {
        "set": { "next": "defaults.review", "href": "/api/v1/onboarding/providers/select" }
      }
    },
    "defaults.review": {
      "representation": {
        "scope": "machine",
        "state": "defaults.review",
        "summary": "How should plans run on this machine?"
      },
      "links": {
        "accept": { "next": "onboard.completed", "href": "/api/v1/onboarding/defaults/validate" }
      }
    },
    "onboard.completed": {
      "representation": {
        "scope": "machine",
        "state": "onboard.completed",
        "summary": "This machine is ready"
      },
      "links": {}
    }
  }
}
