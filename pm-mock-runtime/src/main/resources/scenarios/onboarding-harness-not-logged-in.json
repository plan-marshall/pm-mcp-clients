{
  "format_version": 1,
  "name": "onboarding-harness-not-logged-in",
  "description": "Claude Code is found but not logged in; logging in and checking again passes.",
  "start": "harness.choose",
  "pairing_code": "MOCKMOCK",
  "routes": {
    "GET /api/v1/status": {
      "representation": {
        "status": "onboarding",
        "onboarded": false
      }
    }
  },
  "states": {
    "harness.choose": {
      "representation": {
        "scope": "workspace",
        "state": "harness.choose",
        "summary": "Choose harnesses to enrol"
      },
      "links": {
        "check": {
          "next": "harness.probe",
          "href": "/api/v1/operator/onboard/harness/check"
        }
      }
    },
    "harness.probe": {
      "representation": {
        "scope": "workspace",
        "state": "harness.probe",
        "summary": "Two checks running"
      },
      "events": [
        {
          "after_ms": 600,
          "event": "check",
          "data": {
            "id": "version",
            "result": "pass"
          }
        },
        {
          "after_ms": 1400,
          "event": "check",
          "data": {
            "id": "login",
            "result": "fail",
            "cause": "not logged in",
            "fix": "claude login"
          }
        }
      ],
      "auto": {
        "after_ms": 1500,
        "next": "harness.blocked"
      }
    },
    "harness.blocked": {
      "representation": {
        "scope": "workspace",
        "state": "harness.blocked",
        "summary": "The failed check with its fix"
      },
      "links": {
        "recheck": {
          "next": "harness.probe-passes",
          "href": "/api/v1/operator/onboard/harness/recheck"
        },
        "choose_another": {
          "next": "harness.choose",
          "href": "/api/v1/operator/onboard/harness/choose"
        }
      }
    },
    "harness.probe-passes": {
      "representation": {
        "scope": "workspace",
        "state": "harness.probe-passes",
        "summary": "Checks passing"
      },
      "events": [
        {
          "after_ms": 300,
          "event": "check",
          "data": {
            "id": "version",
            "result": "pass"
          }
        },
        {
          "after_ms": 600,
          "event": "check",
          "data": {
            "id": "login",
            "result": "pass"
          }
        }
      ],
      "auto": {
        "after_ms": 800,
        "next": "harness.confirm"
      }
    },
    "harness.confirm": {
      "representation": {
        "scope": "workspace",
        "state": "harness.confirm",
        "summary": "Harness ready to enrol"
      },
      "links": {
        "enrol": {
          "next": "onboard.completed",
          "href": "/api/v1/operator/onboard/harness/enrol"
        }
      }
    },
    "onboard.completed": {
      "representation": {
        "scope": "workspace",
        "state": "onboard.completed",
        "summary": "Done"
      },
      "links": {}
    }
  }
}
