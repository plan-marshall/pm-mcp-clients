{
  "format_version": 1,
  "name": "onboarding-unknown-harness",
  "description": "A harness the binary does not know is added under Advanced, run to verify its draft profile, and its usage stage fails on a figure the draft names.",
  "start": "harness.choose",
  "pairing_code": "MOCKMOCK",
  "routes": {
    "GET /api/v1/status": {
      "representation": {
        "status": "onboarding",
        "onboarded": false
      }
    }
  },
  "states": {
    "harness.choose": {
      "representation": {
        "scope": "machine",
        "state": "harness.choose",
        "summary": "Choose the harnesses to enrol",
        "harnesses": [
          {
            "harness_id": "claude",
            "name": "Claude Code",
            "path": "~/.local/bin/claude",
            "version": "2.4.1",
            "found": true,
            "supported": true,
            "worker_eligible": true,
            "token_usage": "complete",
            "default": true
          }
        ]
      },
      "links": {
        "add": { "next": "harness.add", "href": "/api/v1/onboarding/harness/add" },
        "choose": { "next": "onboard.completed", "href": "/api/v1/onboarding/harness/choose" }
      }
    },
    "harness.add": {
      "representation": {
        "scope": "machine",
        "state": "harness.add",
        "summary": "Add a harness",
        "executable": "/usr/local/bin/aider",
        "name": "Aider",
        "client_id": "aider",
        "start_from": "opencode"
      },
      "links": {
        "back": { "next": "harness.choose", "href": "/api/v1/onboarding/harness/add/back" },
        "submit": { "next": "harness.add-consent", "href": "/api/v1/onboarding/harness/add/submit" }
      }
    },
    "harness.add-consent": {
      "representation": {
        "scope": "machine",
        "state": "harness.add-consent",
        "kind": "verify_harness_profile",
        "summary": "Run Aider to verify these settings?"
      },
      "links": {
        "no": { "next": "harness.add", "href": "/api/v1/onboarding/harness/add/decline" },
        "yes": { "next": "harness.verify-profile", "href": "/api/v1/onboarding/harness/add/verify" }
      }
    },
    "harness.verify-profile": {
      "representation": {
        "scope": "machine",
        "state": "harness.verify-profile",
        "summary": "Verifying Aider",
        "verification": {
          "stages": {
            "identity": "passed",
            "detection": "passed",
            "launch": "passed",
            "isolation": "passed",
            "classes": "passed",
            "limits": "passed",
            "paths": "passed",
            "faults": "passed",
            "usage": "failed"
          },
          "usage": {
            "coverage": "partial",
            "figures": {
              "input": "reported",
              "cache_write": "not_reported",
              "output": "reported"
            }
          }
        }
      },
      "links": {
        "edit": { "next": "harness.add", "href": "/api/v1/onboarding/harness/add/edit" }
      }
    },
    "onboard.completed": {
      "representation": {
        "scope": "machine",
        "state": "onboard.completed",
        "summary": "This machine is ready"
      },
      "links": {}
    }
  }
}
