{
  "format_version": 1,
  "name": "entry-fresh-code",
  "description": "The entry after a redemption: the code is single use and the next issue is a fresh one (UC-ENT-1, 03-web-server.adoc#fresh-code)",
  "start": "entry.code",
  "pairing_code": "KXQB-MRTN",
  "routes": {
    "GET /api/v1/status": {
      "representation": {
        "status": "ready",
        "version": "0.9.0",
        "machine": "mock-machine",
        "onboarded": true,
        "onboard": {
          "state": "onboard.completed",
          "step": 7,
          "steps": 7,
          "completed": true
        },
        "web": {
          "enabled": true,
          "lan": false,
          "port": 7420,
          "lan_port": 7421,
          "open": true
        },
        "paired_devices_count": 0
      }
    },
    "GET /api/v1/web/devices": {
      "representation": {
        "devices": []
      }
    }
  },
  "states": {
    "entry.code": {
      "representation": {
        "scope": "machine",
        "state": "entry.code",
        "summary": "The ways in, each to copy",
        "code": "KXQB-MRTN"
      },
      "links": {
        "pair": {
          "next": "entry.paired",
          "href": "/api/v1/pair"
        }
      }
    },
    "entry.paired": {
      "representation": {
        "scope": "machine",
        "state": "entry.paired",
        "summary": "Paired; a fresh code follows above the prompt"
      },
      "links": {
        "new_code": {
          "next": "entry.code",
          "href": "/api/v1/web/pairings"
        }
      }
    }
  }
}
