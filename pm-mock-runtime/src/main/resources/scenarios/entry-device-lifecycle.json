{
  "format_version": 1,
  "name": "entry-device-lifecycle",
  "description": "The paired devices of the machine: the list with paired_by, then rename, revoke, and revoke-all-others, and the network listener turned off (UC-ENT-2, 03-web-server.adoc#devices)",
  "start": "devices.list",
  "pairing_code": "KXQB-MRTN",
  "routes": {
    "GET /api/v1/status": {
      "representation": {
        "status": "ready",
        "version": "0.9.0",
        "machine": "mock-machine",
        "onboarded": true,
        "onboard": {
          "state": "onboard.completed",
          "step": 7,
          "steps": 7,
          "completed": true
        },
        "web": {
          "enabled": true,
          "lan": true,
          "port": 7420,
          "lan_port": 7421,
          "open": true
        },
        "paired_devices_count": 3
      }
    },
    "GET /api/v1/web/devices": {
      "representation": {
        "devices": [
          {
            "device_id": "dev-1",
            "label": "Firefox on mbp-oliver",
            "paired_from": "loopback",
            "paired_by": "open",
            "created_at": "2026-05-12T10:00:00Z",
            "last_used_at": "2026-10-16T14:02:00Z"
          },
          {
            "device_id": "dev-2",
            "label": "Safari on iPad",
            "paired_from": "network",
            "paired_by": "entry",
            "created_at": "2026-05-20T10:00:00Z",
            "last_used_at": "2026-10-13T10:00:00Z"
          },
          {
            "device_id": "dev-3",
            "label": "Chrome on build-box",
            "paired_from": "loopback",
            "paired_by": "pair",
            "created_at": "2026-06-02T10:00:00Z",
            "last_used_at": "2026-09-08T10:00:00Z"
          }
        ]
      }
    }
  },
  "states": {
    "devices.list": {
      "representation": {
        "scope": "machine",
        "state": "devices.list",
        "summary": "Paired devices \u00b7 The browsers that can act on this machine",
        "lan_listener_on": true
      },
      "links": {
        "rename": {
          "method": "PATCH",
          "href": "/api/v1/web/devices/dev-1",
          "next": "devices.list"
        },
        "revoke": {
          "method": "DELETE",
          "href": "/api/v1/web/devices/dev-3",
          "next": "devices.list"
        },
        "revoke_others": {
          "method": "DELETE",
          "href": "/api/v1/web/devices?others",
          "next": "devices.list"
        },
        "listener_off": {
          "method": "DELETE",
          "href": "/api/v1/web/listeners/lan",
          "next": "devices.list"
        }
      }
    }
  }
}
