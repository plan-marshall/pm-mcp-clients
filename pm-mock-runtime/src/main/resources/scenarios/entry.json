{
  "format_version": 1,
  "name": "entry",
  "description": "The entry: a machine not onboarded yet, the browser pairing on loopback, the network listener with its certificate fingerprint, and the fresh code after a redemption (UC-ENT-1, UC-ONB-8)",
  "start": "entry.pair",
  "pairing_code": "KXQB-MRTN",
  "routes": {
    "GET /api/v1/status": {
      "representation": {
        "status": "ready",
        "version": "0.9.0",
        "machine": "mock-machine",
        "onboarded": false,
        "onboard": {
          "state": "onboard.mode",
          "step": 0,
          "steps": 7,
          "completed_steps": 0,
          "completed": false
        },
        "web": {
          "enabled": true,
          "lan": true,
          "port": 7420,
          "lan_port": 7421,
          "open": true
        },
        "paired_devices_count": 3
      }
    },
    "GET /api/v1/web/devices": {
      "representation": {
        "devices": [
          {
            "device_id": "dev-1",
            "label": "Firefox on mbp-oliver",
            "paired_from": "loopback",
            "paired_by": "open",
            "created_at": "2026-05-12T10:00:00Z",
            "last_used_at": "2026-10-16T14:02:00Z"
          },
          {
            "device_id": "dev-2",
            "label": "Safari on iPad",
            "paired_from": "lan",
            "paired_by": "entry",
            "created_at": "2026-05-20T10:00:00Z",
            "last_used_at": "2026-10-13T10:00:00Z"
          },
          {
            "device_id": "dev-3",
            "label": "Chrome on build-box",
            "paired_from": "loopback",
            "paired_by": "pair",
            "created_at": "2026-06-02T10:00:00Z",
            "last_used_at": "2026-09-08T10:00:00Z"
          }
        ]
      }
    }
  },
  "states": {
    "entry.pair": {
      "representation": {
        "scope": "machine",
        "state": "entry.pair",
        "summary": "Pair this browser"
      },
      "links": {
        "pair": {
          "next": "entry.paired",
          "href": "/api/v1/pair"
        }
      }
    },
    "entry.paired": {
      "representation": {
        "scope": "machine",
        "state": "entry.paired",
        "summary": "Browser paired; a fresh code follows"
      },
      "links": {}
    },
    "entry.lan-open": {
      "representation": {
        "scope": "machine",
        "state": "entry.lan-open",
        "summary": "Network listener open with its fingerprint",
        "fingerprint": "4F:1A:9C:6D:2B:88:71:03:C5:9E:44:AF:20:DB:16:E2:07"
      },
      "links": {
        "listener_off": {
          "method": "DELETE",
          "href": "/api/v1/web/listeners/lan",
          "next": "entry.pair"
        }
      }
    }
  }
}
