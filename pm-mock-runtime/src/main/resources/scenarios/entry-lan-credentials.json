{
  "format_version": 1,
  "name": "entry-lan-credentials",
  "description": "A credential entered on the network listener is refused loopback_only; the same entry on the loopback listener is accepted (UC-ONB-8, 03-web-server.adoc#web-credentials)",
  "start": "entry.credentials",
  "pairing_code": "KXQB-MRTN",
  "routes": {
    "GET /api/v1/status": {
      "representation": {
        "status": "ready",
        "version": "0.9.0",
        "machine": "mock-machine",
        "onboarded": true,
        "onboard": {
          "state": "onboard.completed",
          "step": 7,
          "steps": 7,
          "completed": true
        },
        "web": {
          "enabled": true,
          "lan": true,
          "port": 7420,
          "lan_port": 7421,
          "open": true
        },
        "paired_devices_count": 1
      }
    },
    "GET /api/v1/web/devices": {
      "representation": {
        "devices": [
          {
            "device_id": "dev-1",
            "label": "Firefox on mbp-oliver",
            "paired_from": "loopback",
            "paired_by": "pair",
            "created_at": "2026-05-12T10:00:00Z",
            "last_used_at": "2026-10-16T14:02:00Z"
          }
        ]
      }
    },
    "PUT /api/v1/credentials/github": {
      "status": 403,
      "representation": {
        "error": "loopback_only",
        "message": "A credential is entered on the loopback listener only"
      }
    }
  },
  "states": {
    "entry.credentials": {
      "representation": {
        "scope": "machine",
        "state": "entry.credentials",
        "summary": "Enter the provider credentials; a secret is entered on this machine only",
        "loopback_only": true
      },
      "links": {}
    }
  }
}
