{
  "format_version": 1,
  "name": "system",
  "description": "System view, runtime lifecycle controls, and cleanup operations (UC-SYS-1..3)",
  "start": "system.ready",
  "pairing_code": "KXQB-MRTN",
  "routes": {
    "GET /api/v1/status": {
      "representation": {
        "status": "ready",
        "version": "0.9.1",
        "lifecycle_state": "running",
        "listener": "unix",
        "machine": {
          "name": "mock-machine",
          "onboarded": true
        },
        "running_since": "today 08:14",
        "uptime_seconds": 22320,
        "workers_count": 5,
        "build_slots_used": 1,
        "build_slots_total": 2,
        "web": {
          "enabled": true,
          "lan": true,
          "port": 7420,
          "open": true
        }
      }
    }
  },
  "states": {
    "system.ready": {
      "representation": {
        "status": "ready",
        "state": "running"
      }
    },
    "system.draining": {
      "representation": {
        "status": "draining",
        "state": "draining",
        "draining_by": "the console",
        "can_withdraw": true
      }
    },
    "system.stopping": {
      "representation": {
        "status": "stopping",
        "state": "stopping"
      }
    },
    "system.upgrading": {
      "representation": {
        "status": "upgrading",
        "state": "upgrading",
        "step": "preparing"
      }
    }
  }
}
