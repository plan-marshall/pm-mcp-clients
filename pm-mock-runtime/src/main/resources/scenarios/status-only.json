{
  "format_version": 1,
  "name": "status-only",
  "description": "Minimal scenario exposing runtime status and liveness",
  "start": "runtime.idle",
  "pairing_code": "MOCKMOCK",
  "routes": {
    "GET /api/v1/status": {
      "representation": {
        "status": "ready",
        "version": "0.1.0-SNAPSHOT",
        "listener": "unix",
        "machine": {
          "name": "mock-machine",
          "onboarded": true
        },
        "projects": []
      }
    }
  },
  "states": {
    "runtime.idle": {
      "representation": {
        "scope": "workspace",
        "state": "runtime.idle",
        "summary": "Runtime is idle"
      },
      "links": {}
    }
  }
}
