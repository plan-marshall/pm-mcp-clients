{
  "format_version": 1,
  "name": "designer",
  "description": "Process designer: installed units at every level, the catalogue of building blocks, validation findings, placing, and removing (UC-PLN-3)",
  "start": "designer.ready",
  "pairing_code": "KXQB-MRTN",
  "routes": {
    "GET /api/v1/status": {
      "representation": {
        "status": "ready",
        "machine": "mbp-oliver",
        "onboarded": true,
        "web": {
          "enabled": true,
          "lan": true,
          "port": 7420,
          "open": true
        }
      }
    },
    "GET /api/v1/workflows": {
      "representation": {
        "units": [
          {
            "name": "landing.pull-request",
            "group": "axis_variant",
            "level_in_force": "machine",
            "frontmatter": {
              "display_name": "Landing Pull Request",
              "description": "Lands the plan as a pull request.",
              "type": "subworkflow",
              "entries": [
                "start"
              ],
              "exits": [
                "merged",
                "no_change"
              ],
              "author": "Oliver Wolff",
              "release": "0.9.0",
              "signed": false
            },
            "levels": [
              {
                "level": "machine",
                "revision": 3,
                "digest": "sha256:lp-m3",
                "text": "workflow landing.pull-request version 3 format 1\n---\nname: Landing Pull Request\ndescription: Lands the plan as a pull request.\ntype: subworkflow\nauthor: Oliver Wolff\nrelease: 0.9.0\nentry start\n---\nstate landing.open\n  call git.commit_and_push\n  done -> merged\n"
              }
            ]
          },
          {
            "name": "git.commit_and_push",
            "group": "recipe",
            "level_in_force": "machine",
            "frontmatter": {
              "display_name": "Commit and Push",
              "description": "Commits the changes of the plan's worktree and pushes its branch.",
              "type": "subworkflow",
              "entries": [
                "commit"
              ],
              "exits": [
                "done",
                "stepped_out"
              ],
              "author": "Oliver Wolff",
              "release": "0.9.0",
              "signed": false
            },
            "levels": [
              {
                "level": "machine",
                "revision": 1,
                "digest": "sha256:gcp-m1",
                "text": "workflow git.commit_and_push version 1 format 1\n---\nname: Commit and Push\ndescription: Commits the changes and pushes the branch.\ntype: recipe\nauthor: Oliver Wolff\nrelease: 0.9.0\nentry commit\nexit done\n---\nstate commit.push\n  done -> done\n"
              }
            ]
          },
          {
            "name": "epic",
            "group": "compiled_only",
            "level_in_force": "default",
            "levels": [
              {
                "level": "default",
                "revision": 1,
                "digest": "sha256:epic-d1",
                "text": "workflow epic version 1 format 1\n"
              }
            ]
          }
        ]
      }
    },
