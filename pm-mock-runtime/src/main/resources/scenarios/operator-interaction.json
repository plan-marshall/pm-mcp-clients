{
  "format_version": 1,
  "name": "operator-interaction",
  "description": "The shared operator interaction of both clients: an operator state with links keyed by their id, check.result events of the closed catalogue, and a moved state whose stale link is refused act_not_available.",
  "start": "wait.choose",
  "pairing_code": "MOCKMOCK",
  "routes": {
    "GET /api/v1/status": {
      "representation": {
        "status": "onboarding",
        "onboarded": false
      }
    }
  },
  "states": {
    "wait.choose": {
      "representation": {
        "scope": { "kind": "machine" },
        "state": { "state_id": "onboarding.choose", "kind": "operator_wait", "level": "machine" },
        "title": { "key": "onboarding.choose.title" },
        "revision": 1,
        "links": [
          {
            "id": "yes",
            "rel": "next",
            "method": "POST",
            "href": "/api/v1/machine/links/yes",
            "preselected": true,
            "confirm": "onboarding.choose.confirm"
          },
          {
            "id": "no",
            "rel": "alt",
            "method": "POST",
            "href": "/api/v1/machine/links/no"
          }
        ]
      },
      "links": {
        "yes": { "next": "wait.check", "href": "/api/v1/machine/links/yes" },
        "no": { "next": "wait.cancelled", "href": "/api/v1/machine/links/no" }
      }
    },
    "wait.check": {
      "representation": {
        "scope": { "kind": "machine" },
        "state": { "state_id": "onboarding.check", "kind": "operator_wait" },
        "progress": { "done": 0, "of": 2 },
        "links": [
          {
            "id": "retry",
            "rel": "retry",
            "method": "POST",
            "href": "/api/v1/machine/links/retry"
          }
        ]
      },
      "events": [
        {
          "after_ms": 200,
          "event": "check.result",
          "data": {
            "event": "check.result",
            "at": "2026-10-18T10:00:00Z",
            "scope": { "kind": "machine" },
            "check_id": "version",
            "result": "pass"
          }
        },
        {
          "after_ms": 600,
          "event": "check.result",
          "data": {
            "event": "check.result",
            "at": "2026-10-18T10:00:02Z",
            "scope": { "kind": "machine" },
            "check_id": "login",
            "result": "fail"
          }
        }
      ],
      "links": {
        "retry": { "next": "wait.choose", "href": "/api/v1/machine/links/retry" }
      },
      "auto": { "after_ms": 900, "next": "wait.moved" }
    },
    "wait.moved": {
      "representation": {
        "scope": { "kind": "machine" },
        "state": { "state_id": "onboarding.moved", "kind": "operator_wait" },
        "links": [
          {
            "id": "restart",
            "rel": "retry",
            "method": "POST",
            "href": "/api/v1/machine/links/restart"
          }
        ]
      },
      "links": {
        "restart": { "next": "wait.choose", "href": "/api/v1/machine/links/restart" }
      }
    },
    "wait.cancelled": {
      "representation": {
        "scope": { "kind": "machine" },
        "state": { "state_id": "onboarding.cancelled", "kind": "terminal" },
        "links": []
      },
      "links": {}
    }
  }
}
