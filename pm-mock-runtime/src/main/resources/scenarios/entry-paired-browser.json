{
  "format_version": 1,
  "name": "entry-paired-browser",
  "description": "The entry on an onboarded machine whose browser is paired already: entry.pairing issues no code, the loopback URL is printed (UC-ENT-1, entry.browser -> entry.show)",
  "start": "entry.paired",
  "pairing_code": "KXQB-MRTN",
  "routes": {
    "GET /api/v1/status": {
      "representation": {
        "status": "ready",
        "version": "0.9.0",
        "machine": "mock-machine",
        "onboarded": true,
        "onboard": {
          "state": "onboard.completed",
          "step": 7,
          "steps": 7,
          "completed": true
        },
        "web": {
          "enabled": true,
          "lan": false,
          "port": 7420,
          "lan_port": 7421,
          "open": true
        },
        "paired_devices_count": 1
      }
    },
    "GET /api/v1/web/devices": {
      "representation": {
        "devices": [
          {
            "device_id": "dev-1",
            "label": "Firefox on mbp-oliver",
            "paired_from": "loopback",
            "paired_by": "open",
            "created_at": "2026-05-12T10:00:00Z",
            "last_used_at": "2026-10-16T14:02:00Z"
          }
        ]
      }
    }
  },
  "states": {
    "entry.paired": {
      "representation": {
        "scope": "machine",
        "state": "entry.paired",
        "summary": "Web app: http://127.0.0.1:7420   (paired: Firefox on mbp-oliver)"
      },
      "links": {}
    }
  }
}
