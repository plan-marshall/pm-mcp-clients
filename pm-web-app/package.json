{
  "name": "pm-web-app",
  "version": "0.1.0-SNAPSHOT",
  "private": true,
  "type": "module",
  "description": "Web client for plan-marshall operator access",
  "engines": {
    "node": ">=22.17",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "prepare": "svelte-kit sync",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ci": "vitest run",
    "test:ci-strict": "vitest run",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,js,svelte,css,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,js,svelte,css,json}\"",
    "quality": "npm run lint && npm run test:ci"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.1.0",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/svelte": "^5.2.7",
    "@types/node": "^22.13.0",
    "eslint": "^9.20.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-security": "^3.0.1",
    "globals": "^15.14.0",
    "jsdom": "^26.0.0",
    "prettier": "^3.5.0",
    "prettier-plugin-svelte": "^3.3.3",
    "qrcode-generator": "^1.5.0",
    "svelte": "^5.57.1",
    "svelte-check": "^4.1.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.0.12",
    "vitest": "^5.0.4"
  }
}
