{
  "name": "pm-web-app",
  "version": "0.1.0-SNAPSHOT",
  "private": true,
  "type": "module",
  "description": "Web client for plan-marshall operator access",
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ci": "vitest run",
    "test:ci-strict": "vitest run",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,js,svelte,css,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,js,svelte,css,json}\"",
    "quality": "npm run lint && npm run test:ci"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/svelte": "^5.2.7",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^22.13.0",
    "eslint": "^9.20.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-security": "^3.0.1",
    "globals": "^15.14.0",
    "jsdom": "^26.0.0",
    "prettier": "^3.5.0",
    "prettier-plugin-svelte": "^3.3.3",
    "svelte": "^5.19.9",
    "svelte-check": "^4.1.4",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  }
}
