<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>de.planmarshall</groupId>
        <artifactId>pm-mcp-clients</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>pm-web-app</artifactId>
    <packaging>jar</packaging>

    <name>pm-web-app</name>
    <description>Web application for plan-marshall operator access (SvelteKit SPA resource JAR)</description>

    <properties>
        <maven.jar.plugin.automatic.module.name>de.planmarshall.web.app</maven.jar.plugin.automatic.module.name>
        <skip.lint>false</skip.lint>
        <skip.npm.build>false</skip.npm.build>
        <skip.typecheck>false</skip.typecheck>
        <sonar.sources>src</sonar.sources>
        <sonar.tests>src</sonar.tests>
        <sonar.test.inclusions>**/*.test.ts,**/*.test.js</sonar.test.inclusions>
        <sonar.coverage.exclusions>**/*</sonar.coverage.exclusions>
        <sonar.cpd.exclusions>**/*</sonar.cpd.exclusions>
    </properties>

    <build>
        <plugins>
            <!-- Node.js and npm management via frontend-maven-plugin -->
            <plugin>
                <groupId>com.github.eirslett</groupId>
                <artifactId>frontend-maven-plugin</artifactId>
                <version>${version.frontend-maven-plugin}</version>
                <configuration>
                    <nodeVersion>${frontend.node.version}</nodeVersion>
                    <npmVersion>${frontend.npm.version}</npmVersion>
                    <installDirectory>target</installDirectory>
                </configuration>
                <executions>
                    <execution>
                        <id>install-node-and-npm</id>
                        <goals>
                            <goal>install-node-and-npm</goal>
                        </goals>
                        <phase>initialize</phase>
                    </execution>
                    <execution>
                        <id>npm-install</id>
                        <goals>
                            <goal>npm</goal>
                        </goals>
                        <phase>initialize</phase>
                        <configuration>
                            <!-- 'ci', not 'install': the build must install exactly the committed
                                 package-lock.json. 'install' may rewrite the lockfile and resolve
                                 beyond it, which hides a lockfile that no longer satisfies the
                                 platform - the failure mode behind rolldown's "Cannot find native
                                 binding" on the Linux runner. 'ci' fails at install time instead. -->
                            <arguments>ci</arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>npm-build</id>
                        <goals>
                            <goal>npm</goal>
                        </goals>
                        <phase>compile</phase>
                        <configuration>
                            <arguments>run build</arguments>
                            <skip>${skip.npm.build}</skip>
                        </configuration>
                    </execution>
                    <execution>
                        <id>npm-test</id>
                        <goals>
                            <goal>npm</goal>
                        </goals>
                        <phase>test</phase>
                        <configuration>
                            <arguments>run test:ci</arguments>
                            <skip>${maven.test.skip}</skip>
                        </configuration>
                    </execution>
                    <execution>
                        <id>npm-lint</id>
                        <goals>
                            <goal>npm</goal>
                        </goals>
                        <phase>verify</phase>
                        <configuration>
                            <arguments>run lint</arguments>
                            <skip>${skip.lint}</skip>
                        </configuration>
                    </execution>
                    <!-- The type check is the gate the editor already shows: 'run build' transpiles the
                         sources without checking their types, so a type error would otherwise reach
                         main while the editor reports it on every file. -->
                    <execution>
                        <id>npm-typecheck</id>
                        <goals>
                            <goal>npm</goal>
                        </goals>
                        <phase>verify</phase>
                        <configuration>
                            <arguments>run check</arguments>
                            <skip>${skip.typecheck}</skip>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Copy built SPA into META-INF/resources for runtime serving -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <executions>
                    <execution>
                        <id>copy-spa-resources</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.outputDirectory}/META-INF/resources</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${project.basedir}/build</directory>
                                    <filtering>false</filtering>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Prove that the SPA build reached the published resource JAR. The copy above and the jar plugin
                 would both succeed on an empty build directory, so the artifact alone is not the evidence:
                 pm-mcp-server serves exactly META-INF/resources, and a regression here would ship a daemon that
                 answers with the placeholder. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <id>verify-spa-resources</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <resourcecount property="spa.index.count">
                                    <zipfileset src="${project.build.directory}/${project.build.finalName}.jar"
                                                includes="META-INF/resources/index.html"/>
                                </resourcecount>
                                <fail message="pm-web-app: ${project.build.finalName}.jar carries no META-INF/resources/index.html; the SPA build did not reach the resource JAR.">
                                    <condition>
                                        <equals arg1="${spa.index.count}" arg2="0"/>
                                    </condition>
                                </fail>
                                <resourcecount property="spa.immutable.count">
                                    <zipfileset src="${project.build.directory}/${project.build.finalName}.jar"
                                                includes="META-INF/resources/_app/immutable/**"/>
                                </resourcecount>
                                <fail message="pm-web-app: ${project.build.finalName}.jar carries no META-INF/resources/_app/immutable asset; the SPA build did not reach the resource JAR.">
                                    <condition>
                                        <equals arg1="${spa.immutable.count}" arg2="0"/>
                                    </condition>
                                </fail>
                                <echo message="pm-web-app: packaged ${spa.index.count} index.html and ${spa.immutable.count} immutable asset(s) under META-INF/resources."/>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
