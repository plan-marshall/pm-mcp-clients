{
  "extends": "$app/tsconfig",
  "include": ["src", "test", "vite.config.ts"],
  "exclude": ["src/service-worker"],
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "resolveJsonModule": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["$app/types", "vitest/globals"]
  }
}
