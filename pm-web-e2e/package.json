{
  "name": "pm-web-e2e",
  "version": "0.1.0-SNAPSHOT",
  "private": true,
  "type": "module",
  "description": "End-to-End Playwright tests for pm-web-app",
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  },
  "scripts": {
    "test": "playwright test",
    "test:ports-guard": "node scripts/guard-ports.js",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "//test:ci-strict": "Departure from a plain test run: the Playwright suite needs a running mock and app, so the strict CI run is the ports guard it would otherwise trip over. Maven runs it at the test phase; the suite itself runs under -Pe2e.",
    "test:ci-strict": "npm run test:ports-guard",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"tests/**/*.{js,ts}\"",
    "format:check": "prettier --check \"tests/**/*.{js,ts}\"",
    "quality": "npm run lint && npm run format:check"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@playwright/test": "^1.50.0",
    "eslint": "^9.20.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-security": "^3.0.1",
    "globals": "^15.14.0",
    "prettier": "^3.5.0"
  }
}
