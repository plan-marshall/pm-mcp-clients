{
  "name": "pm-web-e2e",
  "version": "0.1.0-SNAPSHOT",
  "private": true,
  "type": "module",
  "description": "End-to-End Playwright tests for pm-web-app",
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  },
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"tests/**/*.{js,ts}\"",
    "format:check": "prettier --check \"tests/**/*.{js,ts}\""
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@playwright/test": "^1.50.0",
    "eslint": "^9.20.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-security": "^3.0.1",
    "globals": "^15.14.0",
    "prettier": "^3.5.0"
  }
}
